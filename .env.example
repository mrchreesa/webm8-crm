# Run npm run setup to create a local .env and owner credentials.
NODE_ENV=development
PORT=3001
DATABASE_PATH=./data/crm.sqlite
# Neon pooled PostgreSQL connection URL. Leave blank for local SQLite.
# Server-side only; never use a VITE_ prefix or commit a real connection string.
DATABASE_URL=
APP_URL=http://localhost:5174
OWNER_EMAIL=owner@example.com
OWNER_NAME=Business owner
OWNER_PASSWORD_HASH=
# Default demo. Switching to live requires an explicit action in Meta integration.
META_INITIAL_MODE=demo
META_GRAPH_VERSION=v26.0
META_DATASET_ID=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_CAPI_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_TEST_EVENT_CODE=
WORKER_INTERVAL_MS=3000
# Production uses HTTPS; proxy count must match your reverse proxy topology.
TRUST_PROXY=0
# Vercel production: true for the private queue, with a random CRON_SECRET.
CRM_QUEUE_ENABLED=false
CRON_SECRET=
# Hosted live delivery remains locked until verified and explicitly enabled.
META_LIVE_ENABLED=false
